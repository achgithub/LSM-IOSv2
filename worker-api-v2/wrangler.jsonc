{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ── LSM API v2 — standalone KV-backed authority Worker ───────────────────
  // NOT a replacement for worker-api (V1's live production Worker) — a new,
  // separate deployment built to validate the KV-based sync design in
  // isolation. It has its own KV namespace and NO database of any kind —
  // pure KV, no D1.
  //
  // Whether/how the RedesignV2 iOS client eventually points at this Worker
  // in production, and what happens to worker-api/V1 long-term, is an
  // explicitly separate follow-up decision — not part of standing this up.
  //
  // Identity: worker-api is the "authority" — it owns the App Attest device
  // registry and issues JWTs with its own private key. worker-api-v2 does
  // NOT duplicate that role. It only *verifies* JWTs worker-api issued,
  // exactly the way the existing sports-data shards (worker/) trust the
  // same authority today — see worker/src/middleware/jwt.ts for the
  // reference pattern this mirrors. That's why JWT_PUBLIC_KEYS below is set
  // to worker-api's real public key, not a locally-generated one: a JWT
  // minted by worker-api's /attest/* flow must verify here unmodified.
  //
  // Scope, relative to worker-api:
  //   • JWT verification only — jwt.ts (parsePublicKeys/verifyJWT, pure, no
  //     DB) + middleware/jwt.ts (the requireJWT gate on manager-facing
  //     routes). No attest.ts/attest-config.ts/attest-store.ts/
  //     routes/attest.ts, no attest_devices table, no D1 binding at all.
  //   • Links / rounds / submissions / manager lifecycle — new KV design
  //     (kv/, routes/submissions.ts, routes/manager.ts). See kv/keys.ts for
  //     the full key catalog.
  //   • Global outage flag + /admin/* ops endpoints — intentionally NOT
  //     duplicated here (out of scope for standing up the KV design; would
  //     need its own FLAGS KV namespace with no reuse of worker-api's).

  "name": "lsm-api-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  "env": {
    "uk": {
      "name": "lsm-api-v2-uk",

      "workers_dev": true,
      // No custom_domain route yet — this Worker isn't live/deployed
      // anywhere; routing/domain is part of the deferred migration decision.

      "vars": {
        "REGION": "uk",
        // Same kid + same public key worker-api's uk env uses — this is
        // what makes a JWT minted by worker-api's real /attest/* flow verify
        // successfully here too (see this file's header comment). Copied
        // from worker-api/wrangler.jsonc's uk env; keep in sync if
        // worker-api ever rotates its signing key.
        "JWT_KID": "uk-2026-01",
        "JWT_PUBLIC_KEYS": "{\"uk-2026-01\": \"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEreBcUI2zrxwU0tbhW6MyUcuGa/LlH9eW77tje7Wh/rpV03oCkfXGiYQY7CTzxZErnTLpBARh9dXWdZHKTXep3A==\"}"
      },

      // Own namespace — player links, round pushes, submissions, manager
      // lifecycle. See kv/keys.ts for the full key catalog. `wrangler dev`
      // without --remote uses local (on-disk) KV automatically regardless
      // of this id, so local dev/smoke-testing is unaffected either way.
      "kv_namespaces": [
        { "binding": "SUBMISSIONS_KV", "id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID" }
      ]

      // No d1_databases — this Worker has no database of any kind, pure KV.
      // No triggers.crons — expiry is `expirationTtl` on every KV write,
      // enforced by Cloudflare itself. See kv/retention.ts.
    }
  }
}
